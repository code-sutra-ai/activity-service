{
  "consumer": {
    "name": "UserServiceConsumer"
  },
  "interactions": [
    {
      "description": "a request to create a user",
      "providerStates": [
        {
          "name": "provider accepts a new user"
        }
      ],
      "request": {
        "body": {
          "name": "alice"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/users"
      },
      "response": {
        "body": {
          "id": 101,
          "name": "alice"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.4.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "UserServiceProvider"
  }
}

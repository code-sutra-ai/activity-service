# Resilience4j example configuration
resilience4j.circuitbreaker.instances.default.registerHealthIndicator=true
resilience4j.circuitbreaker.instances.default.slidingWindowSize=10
resilience4j.circuitbreaker.instances.default.minimumNumberOfCalls=5
resilience4j.circuitbreaker.instances.default.failureRateThreshold=50
resilience4j.circuitbreaker.instances.default.waitDurationInOpenState=10000

# JWT secret example (do not use in production)
jwt.secret=your_jwt_secret_key

# Logging
logging.level.root=INFO
logging.level.org.springframework.web=INFO

# Prometheus and Actuator configuration
spring.metrics.export.prometheus.enabled=true
management.endpoints.web.exposure.include=health,info,prometheus
management.endpoint.prometheus.enabled=true
